# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# stop-gate.sh's own per-session retry counter — pure runtime state, never
# meant to be reviewed or committed (unlike docs/issues/, which is).
.claude/hooks/.gate-state/

# Database
*.db

# Node
node_modules/

# Environment — real secrets stay local; only .env.example templates are committed
.env
.env.*
*.env
!.env.example
!*.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test screenshots
app/screenshots/test-*

# Git worktrees — created by /worktree-create and `claude --worktree`. A worktree
# is a full checkout, so ignore it to keep the main tree's status clean on camera.
worktrees/
.claude/worktrees/

# AI Layer hook output — the PostToolUse audit trail is local, never committed.
# (.claude/settings.json IS tracked: it wires .claude/hooks/, the same way
# .claude/skills/ and .claude/agents/ ship the other primitives.)
logs/
.claude/settings.local.json

# Automation run artifacts — output of ./fix-issue.sh and its demo helpers.
# The SCRIPT is tracked (it is the workflow); what one run happened to produce
# is not. Reviews, logs and summaries are per-run and rewritten every time.
fix-issue-run.log
review-logic.md
review-errors.md
RUN-SUMMARY.md
show-run.ps1
.run-stages.txt

# Runtime deploy state — rewritten by deploy.sh on every blue/green flip,
# so keeping it tracked makes every host-side `git pull` abort with a dirty
# working tree. The bootstrap path in deploy.sh writes the initial value
# (`reverse_proxy app-blue:8000`) when the file is absent; the
# upstream.conf.example next to it is the human-readable reference shape.
deploy/upstream.conf
