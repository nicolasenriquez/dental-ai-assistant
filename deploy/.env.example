# DynaChat production secrets. Copy to .env and fill in values.
# .env is gitignored - NEVER commit the filled-in version.

# Supadata (YouTube transcripts) - https://supadata.ai
SUPADATA_API_KEY=

# Postgres (used by docker-compose AND the app)
POSTGRES_USER=dynachat
POSTGRES_PASSWORD=
POSTGRES_DB=dynachat
DATABASE_URL=postgresql://dynachat:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5433/dynachat

# OpenRouter (RAG pipeline - embeddings + chat)
OPENROUTER_API_KEY=

# Clinical drafting stays blocked in production until the data gate is approved.
CLINICAL_EXTERNAL_LLM_ENABLED=false
CLINICAL_TURN_LIMIT_PER_24H=25
VOICE_TRANSCRIPTION_ENABLED=false
VOICE_LANGUAGE=es
WHISPER_URL=http://whisper:9000
WHISPER_MODEL=turbo

# JWT signing secret — 32+ random bytes, e.g. `openssl rand -hex 32`.
# Rotating this value invalidates all live sessions.
JWT_SECRET=

# Admin account — a single hardcoded email, case-insensitive match. When
# unset, every /api/admin/* endpoint returns 403.
ADMIN_USER_EMAIL=

# Authentication mode: `local` (default) or `google`. Google mode requires
# GOOGLE_CLIENT_ID and disables local signup/login.
AUTH_MODE=local
GOOGLE_CLIENT_ID=

# Exact allowed application origins for same-origin JSON guards (comma-separated).
APP_ORIGINS=https://chat.dynamous.ai

# Google Drive managed workspace (optional; disabled when all values absent).
# Partial configuration fails startup — set ALL six values together. Token
# keys are "version:<urlsafe-b64-32-bytes>" pairs, comma-separated.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_AUTO_ONBOARD=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=
GOOGLE_DRIVE_RETURN_URL=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEYS=
GOOGLE_DRIVE_TOKEN_ACTIVE_KEY_VERSION=
